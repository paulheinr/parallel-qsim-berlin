<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!--
Config of the Java router (SwissRailRaptor) for the scenario pt_delays, see ../README.md.

The connections at hub are tight (feeder_0800 reaches hub at 08:06, trunk_0808 leaves at 08:08), so the
parameters that could shift them are set explicitly instead of relying on defaults:
- no extra transfer time,
- the cheapest route is the earliest arrival: waiting and riding cost the same, and a transfer costs nothing extra.
The plans in plans.xml were derived by hand under these assumptions.
-->
<config>
	<module name="global">
		<param name="randomSeed" value="4711"/>
		<param name="coordinateSystem" value="Atlantis"/>
	</module>
	<module name="network">
		<param name="inputNetworkFile" value="network.xml"/>
	</module>
	<module name="transit">
		<param name="useTransit" value="true"/>
		<param name="transitScheduleFile" value="transit_schedule.xml"/>
		<param name="vehiclesFile" value="transit_vehicles.xml"/>
		<param name="transitModes" value="pt"/>
	</module>
	<module name="transitRouter">
		<!-- becomes the minimal transfer time of the raptor (whose own default is 60 s) -->
		<param name="additionalTransferTime" value="0.0"/>
	</module>
	<module name="swissRailRaptor">
		<!-- the router receives the timetable versions of the simulation -->
		<param name="useTimetableUpdates" value="true"/>
	</module>
	<module name="scoring">
		<parameterset type="scoringParameters">
			<!-- the raptor subtracts performing from riding and from waiting, so both cost 12/h -->
			<param name="performing" value="+6"/>
			<param name="waitingPt" value="-6"/>
			<!-- used as the fixed cost of a transfer while transferPenaltyCostPerTravelTimeHour is 0 -->
			<param name="utilityOfLineSwitch" value="0"/>
			<parameterset type="modeParams">
				<param name="mode" value="pt"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-6"/>
			</parameterset>
			<!-- needed by the router for access, egress and transfer walks, which are all 0 m here -->
			<parameterset type="modeParams">
				<param name="mode" value="walk"/>
				<param name="marginalUtilityOfTraveling_util_hr" value="-6"/>
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="home"/>
				<param name="typicalDuration" value="12:00:00"/>
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work"/>
				<param name="typicalDuration" value="08:00:00"/>
			</parameterset>
		</parameterset>
	</module>
</config>
