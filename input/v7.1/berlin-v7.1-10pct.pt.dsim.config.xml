<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!--
	Berlin v7.1, 10pct, with pt, simulated with DSim. Same inputs as berlin-v7.1.10pct.pt.config.yml for rust, see README.md.

	Run with org.matsim.run.dsim.OpenBerlinDSimBenchmark (matsim-berlin, branch ph/v7.1.1-dsim) and
	scoring-config shared-svn/projects/rust-qsim/berlin-v7.1/10pct/berlin-v7.1-10pct.scoring.xml, which holds the scoring parameters.

	Relative paths are relative to this file.
-->
<config>
	<module name="controller">
		<param name="lastIteration" value="0"/>
		<param name="mobsim" value="dsim"/>
		<param name="overwriteFiles" value="deleteDirectoryIfExists"/>
		<param name="runId" value="berlin-v7.1-10pct"/>
		<param name="outputDirectory" value="../../output/v7.1/10pct.pt.dsim/output"/>
		<param name="routingAlgorithmType" value="SpeedyALT"/>
		<param name="writeEventsInterval" value="0"/>
		<param name="writePlansInterval" value="0"/>
		<!-- trips only in iteration 0 and in the last one, which output_trips.csv.gz is copied from --><param name="writeTripsInterval" value="1000"/>
		<param name="createGraphsInterval" value="0"/>
		<!-- Both are global event handlers in DSim, which reduce the parallelism of the mobsim -->
		<param name="legHistogramInterval" value="0"/>
		<param name="legDurationsInterval" value="0"/>
	</module>
	<module name="global">
		<param name="coordinateSystem" value="EPSG:25832"/>
		<param name="insistingOnDeprecatedConfigVersion" value="false"/>
		<!-- Used for replanning. Same as dsim.threads, as the rust binary uses one replanning thread per partition. -->
		<param name="numberOfThreads" value="8"/>
		<param name="randomSeed" value="4711"/>
	</module>
	<module name="network">
		<!-- partitioned for rust, read by DSim with dsim.partitioning = none -->
		<param name="inputNetworkFile" value="../../../../shared-svn/projects/rust-qsim/berlin-v7.1/network/berlin-v7.1.network.metis-minconn-const.008.xml.zst"/>
	</module>
	<module name="plans">
		<param name="inputPlansFile" value="../../../../public-svn/matsim/scenarios/countries/de/berlin/berlin-v7.1/calibrated-10pct/output/berlin-v7.1-10pct.output_plans.xml.gz"/>
		<param name="removingUnnecessaryPlanAttributes" value="true"/>
	</module>
	<module name="vehicles">
		<param name="vehiclesFile" value="../../../../public-svn/matsim/scenarios/countries/de/berlin/berlin-v7.1/calibrated-10pct/output/berlin-v7.1-10pct.output_vehicles.xml.gz"/>
	</module>
	<module name="facilities">
		<param name="facilitiesSource" value="fromFile"/>
		<param name="inputFacilitiesFile" value="../../../../public-svn/matsim/scenarios/countries/de/berlin/berlin-v7.1/calibrated-10pct/output/berlin-v7.1-10pct.output_facilities.xml.gz"/>
	</module>
	<module name="transit">
		<param name="useTransit" value="true"/>
		<param name="transitScheduleFile" value="../../../../public-svn/matsim/scenarios/countries/de/berlin/berlin-v7.1/calibrated-10pct/output/berlin-v7.1-10pct.output_transitSchedule.xml.gz"/>
		<param name="vehiclesFile" value="../../../../public-svn/matsim/scenarios/countries/de/berlin/berlin-v7.1/calibrated-10pct/output/berlin-v7.1-10pct.output_transitVehicles.xml.gz"/>
	</module>
	<module name="routing">
		<param name="networkModes" value="car,truck,freight,ride,bike"/>
		<param name="accessEgressType" value="accessEgressModeToLink"/>
		<param name="clearDefaultTeleportedModeParams" value="true"/>
		<!-- The rust router does not randomize the travel disutility -->
		<param name="routingRandomness" value="0.0"/>
		<parameterset type="teleportedModeParameters">
			<param name="beelineDistanceFactor" value="1.3"/>
			<param name="mode" value="walk"/>
			<param name="teleportedModeSpeed" value="1.23"/>
		</parameterset>
	</module>
	<module name="qsim">
		<!-- DSim uses the flow and storage capacity factors of the qsim, the other values are set in dsim. -->
		<param name="mainMode" value="car,truck,freight"/>
		<param name="flowCapacityFactor" value="0.1"/>
		<param name="storageCapacityFactor" value="0.1"/>
		<param name="startTime" value="00:00:00"/>
		<param name="endTime" value="36:00:00"/>
		<param name="stuckTime" value="30.0"/>
		<param name="trafficDynamics" value="kinematicWaves"/>
		<param name="linkDynamics" value="PassingQ"/>
		<param name="vehiclesSource" value="modeVehicleTypesFromVehiclesData"/>
		<param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="true"/>
		<param name="usePersonIdForMissingVehicleId" value="false"/>
	</module>
	<module name="dsim">
		<!-- Number of threads = partitions. The option "threads" of OpenBerlinDSimBenchmark sets this and global.numberOfThreads. -->
		<param name="threads" value="8"/>
		<!-- none uses the partition attributes of the network -->
		<param name="partitioning" value="none"/>
		<!-- as main_modes in rust; bike and ride are teleported along their network routes -->
		<param name="networkModes" value="car,truck,freight"/>
		<param name="startTime" value="00:00:00"/>
		<param name="endTime" value="36:00:00"/>
		<param name="stuckTime" value="30.0"/>
		<param name="linkDynamics" value="PassingQ"/>
		<param name="trafficDynamics" value="kinematicWaves"/>
		<param name="vehicleBehavior" value="teleport"/>
	</module>
	<module name="travelTimeCalculator">
		<param name="analyzedModes" value="car,truck"/>
		<param name="separateModes" value="true"/>
	</module>
	<module name="linkStats">
		<param name="writeLinkStatsInterval" value="0"/>
	</module>
	<module name="vspExperimental">
		<param name="vspDefaultsCheckingLevel" value="warn"/>
	</module>

	<module name="replanning">
		<param name="fractionOfIterationsToDisableInnovation" value="1.0"/>
		<param name="maxAgentPlanMemorySize" value="5"/>
		<param name="planSelectorForRemoval" value="WorstPlanSelector"/>

		<!-- the same strategies for all subpopulations, as in berlin_iterations_v7 -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.2"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SelectExpBeta"/>
			<param name="subpopulation" value="person"/>
			<param name="weight" value="0.8"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="freight"/>
			<param name="weight" value="0.2"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SelectExpBeta"/>
			<param name="subpopulation" value="freight"/>
			<param name="weight" value="0.8"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="goodsTraffic"/>
			<param name="weight" value="0.2"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SelectExpBeta"/>
			<param name="subpopulation" value="goodsTraffic"/>
			<param name="weight" value="0.8"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="commercialPersonTraffic"/>
			<param name="weight" value="0.2"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SelectExpBeta"/>
			<param name="subpopulation" value="commercialPersonTraffic"/>
			<param name="weight" value="0.8"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="commercialPersonTraffic_service"/>
			<param name="weight" value="0.2"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SelectExpBeta"/>
			<param name="subpopulation" value="commercialPersonTraffic_service"/>
			<param name="weight" value="0.8"/>
		</parameterset>
	</module>

	<!-- The scoringParameters sets come from the scoring config (OpenBerlinDSimBenchmark scoring-config). -->
	<module name="scoring">
		<param name="brainExpBeta" value="1.0"/>
		<param name="learningRate" value="1.0"/>
		<param name="writeExperiencedPlans" value="false"/>
		<param name="pathSizeLogitBeta" value="0"/>
	</module>

</config>
